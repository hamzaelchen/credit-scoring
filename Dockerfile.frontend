FROM nginx:alpine

# Valeurs par défaut lues par le modèle nginx ; docker-compose peut les surcharger
ENV API_URL=http://localhost:8000 \
    GITHUB_URL=

# Le modèle est traité par envsubst au démarrage (voir nginx/default.conf.template)
COPY nginx/default.conf.template /etc/nginx/templates/default.conf.template
COPY frontend/ /usr/share/nginx/html/

EXPOSE 80
